{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd packages/web && bun run build",
  "outputDirectory": "packages/web/dist",
  "functions": {
    "packages/web/api/[...path].ts": {
      "maxDuration": 30,
      "includeFiles": "**"
    }
  },
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}