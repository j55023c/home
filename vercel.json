{
  "buildCommand": "cd packages/web && bun run build",
  "outputDirectory": "packages/web/dist",
  "functions": {
    "packages/web/api/rpc.ts": {
      "maxDuration": 30,
      "includeFiles": "packages/web/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/rpc.ts" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}